{
  "rewrites": [
    {
      "source": "/api/upload-avatar",
      "destination": "/api/upload-avatar"
    },
    {
      "source": "/api/:path*",
      "destination": "http://visualdsa.runasp.net/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://visualdsa.runasp.net/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

