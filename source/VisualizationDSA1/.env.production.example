# Production Environment Variables for VisualizationDSA
# Copy this file to .env.production and fill in the values

# ─────────────────────────────────────────────────────────────
# DOMAIN & SSL
# ─────────────────────────────────────────────────────────────
DOMAIN=visualizationdsa.dev
# Generate SSL certificates with Let's Encrypt:
# certbot certonly --standalone -d visualizationdsa.dev -d www.visualizationdsa.dev
# Then place certs in ./certs/ directory

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=visualization_dsa_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_MIN_32_CHARS

# ─────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_KEY=CHANGE_ME_64_CHAR_BASE64_STRING
JWT_ISSUER=VisualizationDSA
JWT_AUDIENCE=VisualizationDSAUsers

# ─────────────────────────────────────────────────────────────
# EXTERNAL SERVICES (Optional)
# ─────────────────────────────────────────────────────────────
# Google OAuth (if enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email service (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@visualizationdsa.dev

# AI Assistant (OpenAI compatible)
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4-turbo-preview

# ─────────────────────────────────────────────────────────────
# MONITORING (Optional)
# ─────────────────────────────────────────────────────────────
# Grafana/Loki/Prometheus
GRAFANA_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Sentry (error tracking)
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────
ENABLE_AI_ASSISTANT=true
ENABLE_JUDGE0=true
ENABLE_REALTIME=true
ENABLE_PAYMENT=true

# ─────────────────────────────────────────────────────────────
# BUILD ARGS (for Docker)
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://visualizationdsa.dev/api