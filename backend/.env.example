# ── Backend: biến môi trường (DEPLOY.md §2.1) ─────────────────────────
# Copy sang .env hoặc export trực tiếp. KHÔNG commit secret thật.

# BẮT BUỘC — tạo chuỗi ngẫu nhiên ≥ 32 ký tự (DEPLOY §2.4), không dùng giá trị mẫu này
DSA__Jwt__Secret=change-me-32-characters-minimum-secret

# BẮT BUỘC — SQL Server (docker-compose: Server=sqlserver;... / dev local: Server=localhost;...)
ConnectionStrings__Default=Server=localhost;Database=DsaVisual;User Id=sa;Password=DsaVisual@Dev123;TrustServerCertificate=True

# Tùy chọn (mặc định hợp lý)
DSA__Jwt__AccessTokenMinutes=60
DSA__Jwt__RefreshTokenDays=7
DSA__Cors__AllowedOrigins=http://localhost:5173

# SMTP (dev/staging dùng MailHog — bỏ trống = chế độ log, KHÔNG block đăng ký/đăng nhập — SDD §5.6)
DSA__Email__SmtpHost=localhost
DSA__Email__SmtpPort=1025
DSA__Email__From=no-reply@dsa-visual.local

# Admin seed (placeholder — KHÔNG dùng giá trị này ở production)
Admin__Email=admin@dsa-visual.local
Admin__Password=ChangeMe@123
